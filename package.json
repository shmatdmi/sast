{
  "name": "codesentry-local-sast",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "image:build": "node scripts/build-image.mjs",
    "image:publish": "node scripts/build-image.mjs --push",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:unit",
    "test:coverage": "node scripts/test-unit.mjs --coverage",
    "rules:catalog": "node scripts/generate-rule-catalog.mjs",
    "rules:seed": "node scripts/seed-sast-rules.mjs",
    "test:rules-db": "node --test tests/rule-catalog-db.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern tmp",
    "check": "npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:unit": "node scripts/test-unit.mjs",
    "test:integration": "npm run build && node scripts/test-api.mjs",
    "test:all": "npm run check && node scripts/test-api.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "next": "^16.3.5",
    "postgres": "^3.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "^0.0.50",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "^4.92.0"
  },
  "type": "module"
}
